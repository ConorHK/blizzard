# Run to create: agenix-rekey edit ./matrix-synapse-secrets.age
# Contents (homeserver.yaml fragment):
#   registration_shared_secret: <pwgen -s 64 1>
#   macaroon_secret_key: <pwgen -s 64 1>
#   form_secret: <pwgen -s 64 1>
#
# Run to create: agenix-rekey edit ./mautrix-whatsapp-env.age
# Contents (KEY=value format):
#   MAUTRIX_WHATSAPP_PICKLE_KEY=<pwgen -s 64 1>
#
# Run to create: agenix-rekey edit ./mautrix-discord-env.age
# Contents (KEY=value format):
#   MAUTRIX_DISCORD_PICKLE_KEY=<pwgen -s 64 1>
