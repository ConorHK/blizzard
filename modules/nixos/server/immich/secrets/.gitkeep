# Run to create: agenix-rekey edit ./immich-secrets.age
# Contents (KEY=value format):
#   POSTGRES_PASSWORD=<postgres password (used by immich-db)>
#   DB_PASSWORD=<postgres password (same value, used by immich-server)>

# Run to create: agenix-rekey edit ./immich-stack-secrets.age
# Contents (KEY=value format):
#   API_KEY=<immich api key from server's immich, Account Settings -> API Keys>
