# gluetun.age (agenix edit ./gluetun.age):
#   WIREGUARD_PRIVATE_KEY=<nordlynx key>
# Fetch the key with a NordVPN access token:
#   curl -s -u token:<TOKEN> https://api.nordvpn.com/v1/users/services/credentials | jq -r .nordlynx_private_key
#
# arr-api-keys.age (agenix edit ./arr-api-keys.age):
#   SONARR__AUTH__APIKEY=<32 hex chars>
#   RADARR__AUTH__APIKEY=<32 hex chars>
#   UN_SONARR_0_API_KEY=<same as SONARR__AUTH__APIKEY>
#   UN_RADARR_0_API_KEY=<same as RADARR__AUTH__APIKEY>
# Generate a key with: openssl rand -hex 16
