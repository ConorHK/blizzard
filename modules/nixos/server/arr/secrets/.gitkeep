# Run to create: agenix-rekey edit ./arr-secrets.age
# Contents (KEY=value format):
#   POSTGRES_PASSWORD=<jellystat postgres password>
#   JWT_SECRET=<jellystat jwt secret>
#   UN_SONARR_0_API_KEY=<sonarr api key from sonarr Settings > General>
#   UN_RADARR_0_API_KEY=<radarr api key from radarr Settings > General>
