# Run to create (needs the YubiKey master identity):
#   agenix-rekey edit ./dmvault-secrets.age
#
# Contents (KEY=value format):
#   DATOMIC_PASSWORD=<datomic app password>
#   ADMIN_PASSWORD=<datomic admin password — MUST differ from DATOMIC_PASSWORD>
#   DATOMIC_URL=datomic:free://datomic:4334/orcpub?password=<same value as DATOMIC_PASSWORD>
#   SIGNATURE=<random 20+ char string for browser-side password hashing>
#   EMAIL_SECRET_KEY=<Resend API key, starts with re_>
