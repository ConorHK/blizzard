+/// Joins wrapped rows that form one URL or path.
+pub fn join_wrapped_link(text: &str) -> Option<String> {
+    if !text.contains('\n') {
+        return None;
+    }
+    let joined: String = text.lines().map(str::trim).collect();
+    // Paths often carry a `:line:col` suffix.
+    let link = joined.trim_end_matches(|ch: char| ch == ':' || ch.is_ascii_digit());
+    built_in_patterns()
+        .iter()
+        .filter(|pattern| matches!(pattern.name.as_str(), "url" | "path"))
+        .any(|pattern| {
+            pattern
+                .regex
+                .find(link)
+                .is_some_and(|found| found.range() == (0..link.len()))
+        })
+        .then_some(joined)
+}
