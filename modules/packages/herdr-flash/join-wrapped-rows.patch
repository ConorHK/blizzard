+    /// Wrappers move a word down only when it overflows.
+    fn row_break(&self, row: usize, width: usize) -> RowBreak {
+        let chars = self.chars(row);
+        if chars
+            .last()
+            .is_some_and(|last| last.col + cell_width(last.ch) >= width)
+        {
+            return RowBreak::Soft;
+        }
+        let next_word = self.first_word_width(row + 1);
+        if next_word == 0 || self.content_end(row) + 1 + next_word + WRAP_MARGIN <= width {
+            return RowBreak::Line;
+        }
+        let text: String = chars.iter().map(|grid_char| grid_char.ch).collect();
+        if text.trim().contains(char::is_whitespace) {
+            RowBreak::Word
+        } else {
+            RowBreak::Token
+        }
+    }
