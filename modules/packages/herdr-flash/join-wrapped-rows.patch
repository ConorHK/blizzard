+    /// Selected text with wrapped rows rejoined.
+    pub fn yank_text(&self, grid: &Grid, width: usize) -> Option<String> {
+        let pieces = self.pieces(grid)?;
+        let mut lines = Vec::new();
+        let mut group = Vec::new();
+        for (index, (row, piece)) in pieces.iter().enumerate() {
+            let row_break = if index + 1 < pieces.len() {
+                grid.row_break(*row, width)
+            } else {
+                RowBreak::Line
+            };
+            group.push((piece.as_str(), row_break));
+            if row_break == RowBreak::Line {
+                lines.push(join_rows(&group));
+                group.clear();
+            }
+        }
+        Some(lines.join("\n"))
+    }
