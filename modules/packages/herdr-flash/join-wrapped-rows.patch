+
+/// Joins one wrapped line's rows.
+fn join_rows(rows: &[(&str, RowBreak)]) -> String {
+    if rows.len() > 1 {
+        let text = rows
+            .iter()
+            .map(|(piece, _)| *piece)
+            .collect::<Vec<_>>()
+            .join("\n");
+        if let Some(link) = join_wrapped_link(&text) {
+            return link;
+        }
+    }
+    let mut line = String::new();
+    let mut previous = RowBreak::Line;
+    for (piece, row_break) in rows {
+        let piece = match previous {
+            RowBreak::Word | RowBreak::Token => piece.trim_start(),
+            RowBreak::Line | RowBreak::Soft => piece,
+        };
+        let piece = match row_break {
+            RowBreak::Soft => piece,
+            _ => piece.trim_end(),
+        };
+        line.push_str(piece);
+        if *row_break == RowBreak::Word {
+            line.push(' ');
+        }
+        previous = *row_break;
+    }
+    line
+}
