{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "configMigration": true,
  "prHourlyLimit": 0,
  "enabledManagers": [
    "github-actions",
    "npm",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.nix$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*\\S+\\s*=\\s*\"[^:\"]+:(?<currentValue>[^\"@]+)(@(?<currentDigest>sha256:[a-f0-9]+))?\";"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Postgres majors need a dump and restore.",
      "matchDepNames": [
        "ghcr.io/immich-app/postgres"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "pi extensions: pinned, one grouped PR; CI loads them in headless pi.",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "modules/home/core/cli/ai/pi/npm/package.json"
      ],
      "rangeStrategy": "pin",
      "groupName": "pi extensions"
    }
  ]
}
